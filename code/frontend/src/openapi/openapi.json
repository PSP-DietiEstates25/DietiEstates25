          "size": { "type": "integer", "format": "int32" },
          "page": { "type": "integer", "format": "int32" },
          "userEmail": { "type": "string", "minLength": 1 },
          "detailId": { "type": "integer", "format": "int64" },
          "cadastralFilter": {
            "$ref": "#/components/schemas/CadastralFilterRequest"
          }
        },
        "required": ["cadastralFilter", "category", "page", "size", "userEmail"]
      },
      "RealEstateResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "category": { "type": "string" },
          "images": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" },
          "createdDate": { "type": "string", "format": "date-time" },
          "lastModifiedDate": { "type": "string", "format": "date-time" },
          "estateAgentEmail": { "type": "string" },
          "detailId": { "type": "integer", "format": "int64" },
          "cadastralDataId": { "type": "integer", "format": "int64" }
        }
      },
      "RealEstateRequest": {
        "type": "object",
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "images": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "description": { "type": "string", "minLength": 1 },
          "estateAgentEmail": { "type": "string", "minLength": 1 }
        },
        "required": ["category", "description", "estateAgentEmail", "images"]
      },
      "OfferRequest": {
        "type": "object",
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "userEmail": { "type": "string", "minLength": 1 },
          "amount": { "type": "number" }
        },
        "required": ["amount", "category", "status", "userEmail"]
      },
      "CadastralDataRequest": {
        "type": "object",
        "properties": {
          "price": { "type": "number" },
          "squareMeters": { "type": "integer", "format": "int32" },
          "energyClass": { "type": "string", "minLength": 1 },
          "rooms": { "type": "integer", "format": "int32" },
          "floor": { "type": "integer", "format": "int32" }
        },
        "required": ["energyClass", "floor", "price", "rooms", "squareMeters"]
      },
      "VisitRequest": {
        "type": "object",
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "userEmail": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "format": "date", "minLength": 1 },
          "time": { "type": "string", "minLength": 1 }
        },
        "required": ["category", "date", "status", "time", "userEmail"]
      },
      "NotificationCategoryRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "isActive": { "type": "boolean" }
        },
        "required": ["isActive", "name"]
      },
      "NotificationRequest": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "minLength": 1 },
          "notificationCategoryName": { "type": "string", "minLength": 1 },
          "userEmail": { "type": "string", "minLength": 1 }
        },
        "required": ["message", "notificationCategoryName", "userEmail"]
      },
      "DetailRequest": {
        "type": "object",
        "properties": {
          "realEstateId": { "type": "integer", "format": "int64" },
          "searchId": { "type": "integer", "format": "int64" }
        }
      },
      "UtilityRequest": {
        "type": "object",
        "properties": {
          "hasAirConditioning": { "type": "boolean" },
          "hasDoorman": { "type": "boolean" },
          "hasElevator": { "type": "boolean" }
        },
        "required": ["hasAirConditioning", "hasDoorman", "hasElevator"]
      },
      "GeographicalPositionRequest": {
        "type": "object",
        "properties": {
          "city": { "type": "string", "minLength": 1 },
          "municipality": { "type": "string", "minLength": 1 },
          "address": { "type": "string", "minLength": 1 },
          "latitude": { "type": "number", "format": "double", "minimum": -180 },
          "longitude": { "type": "number", "format": "double", "minimum": -90 },
          "radius": { "type": "integer", "format": "int32" }
        },
        "required": ["address", "city", "latitude", "longitude", "municipality"]
      },
      "AuthenticationRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "minLength": 1 },
          "password": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 }
        },
        "required": ["email", "password", "role"]
      },
      "Admin": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "username": { "type": "string" },
          "email": { "type": "string" },
          "password": { "type": "string" },
          "accountLocked": { "type": "boolean" },
          "enabled": { "type": "boolean" },
          "roles": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Role" }
          },
          "createdDate": { "type": "string", "format": "date-time" },
          "lastModifiedDate": { "type": "string", "format": "date-time" },
          "admin": { "$ref": "#/components/schemas/Admin" },
          "estateAgents": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/EstateAgent" }
          },
