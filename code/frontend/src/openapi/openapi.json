{
  "openapi": "3.1.0",
  "info": { "title": "OpenAPI definition", "version": "v0" },
  "servers": [
    {
      "url": "http://localhost:8080/api/v1",
      "description": "Generated server url"
    }
  ],
  "paths": {
    "/details": {
      "post": {
        "tags": ["detail-controller"],
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateDetailRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IdResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["authentication-controller"],
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegistrationRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": { "schema": { "type": "object" } }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["authentication-controller"],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ads": {
      "post": {
        "tags": ["real-estate-ad-controller"],
        "operationId": "createAd",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "payload": {
                    "$ref": "#/components/schemas/CreateRealEstateAdRequest"
                  },
                  "photo": { "type": "string", "format": "binary" }
                },
                "required": ["payload", "photo"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RealEstateAdResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/ads/search": {
      "get": {
        "tags": ["real-estate-ad-query-controller"],
        "operationId": "search",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["SALE", "RENT"] }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "minPrice",
            "in": "query",
            "required": false,
            "schema": { "type": "number" }
          },
          {
            "name": "maxPrice",
            "in": "query",
            "required": false,
            "schema": { "type": "number" }
          },
          {
            "name": "minRooms",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32" }
          },
          {
            "name": "energy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["A4", "A3", "A2", "A1", "B", "C", "D", "E", "F", "G"]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "default": 0 }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "default": 12 }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RealEstateAdResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/ads/dashboard": {
      "get": {
        "tags": ["real-estate-ad-query-controller"],
        "operationId": "mine",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "default": 0 }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "default": 12 }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RealEstateAdResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateDetailRequest": {
        "type": "object",
        "properties": {
          "services": { "$ref": "#/components/schemas/ServicesDTO" },
          "geo": { "$ref": "#/components/schemas/GeographicalPositionDTO" }
        },
        "required": ["geo", "services"]
      },
      "GeographicalPositionDTO": {
        "type": "object",
        "properties": {
          "city": { "type": "string", "minLength": 1 },
          "municipality": { "type": "string", "minLength": 1 },
          "zoneMarkerLatitude": {
            "type": "number",
            "format": "double",
            "maximum": 90.0,
            "minimum": -90.0
          },
          "zoneMarkerLongitude": {
            "type": "number",
            "format": "double",
            "maximum": 180.0,
            "minimum": -180.0
          },
          "zoneMarkerRadius": { "type": "number", "format": "float" }
        },
        "required": [
          "city",
          "municipality",
          "zoneMarkerLatitude",
          "zoneMarkerLongitude",
          "zoneMarkerRadius"
        ]
      },
      "ServicesDTO": {
        "type": "object",
        "properties": {
          "hasAirConditioning": { "type": "boolean" },
          "hasDoorman": { "type": "boolean" },
          "hasElevator": { "type": "boolean" }
        },
        "required": ["hasAirConditioning", "hasDoorman", "hasElevator"]
      },
      "IdResponse": {
        "type": "object",
        "properties": { "id": { "type": "integer", "format": "int64" } }
      },
      "RegistrationRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "minLength": 1 },
          "password": {
            "type": "string",
            "maxLength": 2147483647,
            "minLength": 8
          }
        },
        "required": ["email", "password"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "minLength": 1 },
          "password": {
            "type": "string",
            "maxLength": 2147483647,
            "minLength": 8
          }
        },
        "required": ["email", "password"]
      },
      "AuthenticationResponse": {
        "type": "object",
        "properties": { "token": { "type": "string" } }
      },
      "CreateRealEstateAdRequest": {
        "type": "object",
        "properties": {
          "category": { "type": "string", "enum": ["SALE", "RENT"] },
          "description": { "type": "string", "minLength": 1 },
          "price": { "type": "number", "minimum": 0.0 },
          "size": { "type": "number", "format": "float" },
          "address": { "type": "string", "minLength": 1 },
          "rooms": { "type": "integer", "format": "int32" },
          "floor": { "type": "integer", "format": "int32" },
          "energyClass": {
            "type": "string",
            "enum": ["A4", "A3", "A2", "A1", "B", "C", "D", "E", "F", "G"]
          },
          "latitude": { "type": "number", "format": "double" },
          "longitude": { "type": "number", "format": "double" },
          "detailId": { "type": "integer", "format": "int64" }
        },
        "required": [
          "address",
          "category",
          "description",
          "detailId",
          "energyClass",
          "floor",
          "latitude",
          "longitude",
          "price",
          "rooms",
          "size"
        ]
      },
      "RealEstateAdResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "category": { "type": "string" },
          "description": { "type": "string" },
          "price": { "type": "number" },
          "size": { "type": "number", "format": "float" },
          "address": { "type": "string" },
          "rooms": { "type": "integer", "format": "int32" },
          "floor": { "type": "integer", "format": "int32" },
          "energyClass": { "type": "string" },
          "latitude": { "type": "number", "format": "double" },
          "longitude": { "type": "number", "format": "double" },
          "postedByEmail": { "type": "string" },
          "detailId": { "type": "integer", "format": "int64" }
        }
      }
    }
  }
}
